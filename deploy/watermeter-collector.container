# Quadlet unit for the water meter collector (edge node: Pi 4B / Fedora IoT).
#
# Install to: /etc/containers/systemd/watermeter-collector.container
# (rootful Podman -- run via the system systemd units, not a user unit).
#
# No-touch updates:
#   - The image is pulled from your GitHub Container Registry (built by
#     .github/workflows/release.yml on every push to main / version tag).
#   - AutoUpdate=registry + the podman-auto-update.timer make the Pi pull
#     and restart the container automatically when a new image is published.
#   - Fedora IoT's automatic OS update mechanism handles the OS layer.
#
# The image is published by .github/workflows/release.yml to the GitHub
# Container Registry under the stbrown57 account.

[Unit]
Description=Water meter ERT collector (rtl_tcp + rtlamr + metrics exporter)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/stbrown57/watermeter-collector:latest
AutoUpdate=registry
# Explicitly run as root (rootful Podman). The image is rootful by design:
# it needs host-level access to the RTL-SDR USB bus (/dev/bus/usb) and keeps
# its state + raw archive under /data on the host filesystem.
User=root
# Arguments to the collector binary:
Exec=-meter-id 81623781 -msgtype=scm+ -raw-log /data/raw.jsonl -state-file /data/state.json
# Raw message archive + persisted baseline survive restarts and OS updates:
# (rootful host path - created on first start if missing)
Volume=/var/lib/watermeter/data:/data:Z
# USB access for the RTL-SDR (the whole bus, since device paths can move):
AddDevice=/dev/bus/usb
PublishPort=9101:9101

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
